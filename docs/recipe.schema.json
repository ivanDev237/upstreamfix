{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpstreamFix declarative migration recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "package", "fromMajor", "toMajor", "releasedAt", "title", "guideUrl", "nodeMajor", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 500 },
    "package": { "type": "string", "minLength": 1, "maxLength": 500 },
    "fromMajor": { "type": "integer", "minimum": 1, "maximum": 99 },
    "toMajor": { "type": "integer", "minimum": 1, "maximum": 99 },
    "releasedAt": { "type": "string", "minLength": 10, "maxLength": 10 },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "guideUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
    "nodeMajor": { "type": "integer", "minimum": 1, "maximum": 99 },
    "rules": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "id", "name"],
        "properties": {
          "kind": { "enum": ["export-rename", "import-move", "namespace-call", "chained-namespace-call", "namespace-property", "method-rename", "manual-namespace-call"] },
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 500 },
          "to": { "type": "string", "minLength": 1, "maxLength": 500 },
          "from": { "type": "string", "minLength": 1, "maxLength": 500 },
          "receiver": { "type": "string", "minLength": 1, "maxLength": 500 },
          "via": { "type": "string", "minLength": 1, "maxLength": 500 },
          "message": { "type": "string", "minLength": 1, "maxLength": 300 },
          "noArguments": { "type": "boolean" }
        }
      }
    }
  }
}
